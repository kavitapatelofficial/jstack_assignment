{
  "info": {
    "name": "jWallet Lite API Collection",
    "description": "Postman collection for jWallet Lite backend APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "mock_access_token_123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@jstack.co\",\n  \"password\": \"Demo@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "2. Get Profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "users", "profile"]
        }
      }
    },
    {
      "name": "3. Get Wallet Balance",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/wallet/balance",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "wallet", "balance"]
        }
      }
    },
    {
      "name": "4. Get Transactions",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "transactions"]
        }
      }
    },
    {
      "name": "5. Send Money (Transfer)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Idempotency-Key", "value": "req-transfer-sample-1" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"beneficiaryName\": \"Rahul Sharma\",\n  \"mobileNumber\": \"9876543210\",\n  \"amount\": 1500.00,\n  \"remarks\": \"Payment for services\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions/transfer",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "transactions", "transfer"]
        }
      }
    },
    {
      "name": "6. Get Transaction By ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions/TXN10001",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "transactions", "TXN10001"]
        }
      }
    },
    {
      "name": "7. Reset Wallet State",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/v1/wallet/reset",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "wallet", "reset"]
        }
      }
    }
  ]
}
